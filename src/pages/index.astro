---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { DailyBib, SeasonBoard, RecentlyPlayed } from '../components/HomeWidgets';
import { CATEGORIES, GAMES } from '../data/catalog';

const lanes = CATEGORIES.map((c, i) => ({
  ...c,
  lane: i + 1,
  flagship: GAMES.find((g) => g.category === c.id && g.flagship)!,
  count: GAMES.filter((g) => g.category === c.id && !g.url.includes('reference')).length,
}));
---
<BaseLayout
  title="SkillSprint – Free Brain & Skill Training Games"
  rawTitle
  description="Train your typing speed, reaction time, memory, mental math, vocabulary, geography, keyboard shortcuts, logic, colour vision and reading speed. Free, no sign-up."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1><span>Train your mind.</span> <span>Challenge your limits.</span></h1>
        <p class="lead">
          Ten quick skill games, from typing speed to mental maths, each with a score to beat.
          Pick a lane, set a personal best, then come back tomorrow for a new daily challenge.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href="#lanes">Pick a lane</a>
          <a class="btn btn-secondary btn-lg" href="/daily/">Today’s challenge</a>
        </div>
        <p class="hero-note">Free to play. No account. Your scores are saved in this browser.</p>
      </div>
      <DailyBib client:load />
    </div>
  </section>

  <section class="track" id="lanes" aria-labelledby="lanes-title">
    <div class="container track-head">
      <h2 id="lanes-title">Pick a lane</h2>
      <p>Each lane is one skill. Your personal best (PB) for each lane shows up here once you have played it.</p>
    </div>
    <ol class="lanes">
      {lanes.map((l) => (
        <li class="lane" data-cat={l.id}>
          <a class="container" href={l.url} aria-label={`Lane ${l.lane}: ${l.name}. ${l.tagline}`}>
            <span class="lane-num" aria-hidden="true">{l.lane}</span>
            <span class="lane-body">
              <span class="lane-name">{l.name}</span>
              <span class="lane-desc">{l.tagline} {l.count > 1 ? `${l.count} games.` : ''}</span>
            </span>
            <span class="lane-pb" data-pb={l.flagship.gameId}>
              <span class="pb-none">Not run yet</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <div class="container">
    <section class="section grid grid-2" aria-label="Your progress" style="align-items:start">
      <div>
        <h2>Your season</h2>
        <SeasonBoard client:load />
      </div>
      <div>
        <h2>Latest results</h2>
        <RecentlyPlayed client:load />
        <p style="margin-top:1rem"><a href="/stats/">All your stats and personal bests</a></p>
      </div>
    </section>

    <AdSlot slot="home-banner" size="banner" />

    <section class="section prose" aria-labelledby="why" style="padding-top:1rem">
      <h2 id="why">Short sessions, real progress</h2>
      <p>
        Skills like typing, mental arithmetic and quick recall improve fastest with short, focused practice and honest feedback.
        Every SkillSprint game gives you an exact score, keeps your personal best and explains the answers you missed, so a
        two-minute session still teaches you something.
      </p>
      <p>
        There is nothing to sign up for. Results are stored in your browser on this device only, and you can delete them at any
        time from <a href="/stats/">My stats</a>. Read more <a href="/about/">about SkillSprint</a> or see how we handle data in
        our <a href="/privacy/">Privacy Policy</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { load } from '../lib/storage';
  import { SCORE_RULES } from '../data/catalog';

  // Fill each lane with the visitor's personal best from local storage.
  const data = load();
  document.querySelectorAll<HTMLElement>('[data-pb]').forEach((el) => {
    const gameId = el.dataset.pb!;
    const lower = SCORE_RULES[gameId]?.better === 'lower';
    let best: { score: number; display: string } | null = null;
    for (const [key, rec] of Object.entries(data.bests)) {
      if (key.split('|')[0] !== gameId) continue;
      if (!best || (lower ? rec.score < best.score : rec.score > best.score)) best = rec;
    }
    if (best) {
      el.innerHTML = '';
      const flag = document.createElement('span');
      flag.className = 'pb-flag';
      flag.textContent = 'PB';
      const value = document.createElement('span');
      value.className = 'pb-value';
      value.textContent = best.display;
      el.append(flag, value);
    }
  });
  // Paint the lane lines once per visit.
  try {
    if (!sessionStorage.getItem('ss-track-painted')) {
      document.querySelector('.track')?.classList.add('animate');
      sessionStorage.setItem('ss-track-painted', '1');
    }
  } catch {
    /* storage blocked: skip the animation */
  }
</script>
