---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import AdSlot from '../components/AdSlot.astro';
import { CATEGORIES, gamesInCategory } from '../data/catalog';
---
<PageLayout
  title="All Skill Training Games"
  description="Browse every SkillSprint game: typing tests, reaction time, memory, mental math, vocabulary, geography, keyboard shortcuts, logic puzzles, colour and reading speed."
  heading="All games"
  lead="Ten skills in one place. Every game is free and works in your browser — no download, no account."
>
  <div class="grid" style="gap:2.25rem">
    {CATEGORIES.map((c) => (
      <section aria-labelledby={`cat-${c.id}`} data-cat={c.id}>
        <div class="section-head" style="margin-bottom:.9rem">
          <div style="display:flex;gap:.8rem;align-items:center">
            <span class="cat-icon"><Icon name={c.id} /></span>
            <div>
              <h2 id={`cat-${c.id}`} style="font-size:1.35rem;margin:0"><a href={c.url} style="color:inherit;text-decoration:none">{c.name}</a></h2>
              <p style="margin:.15rem 0 0">{c.description}</p>
            </div>
          </div>
        </div>
        <div class="grid grid-3">
          {gamesInCategory(c.id).map((g) => (
            <a class="game-card" href={g.url} data-cat={g.category}>
              <span class="cat-icon"><Icon name={g.category} /></span>
              <span><h3>{g.name}</h3><p>{g.short}</p></span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  <AdSlot slot="content" size="banner" />
</PageLayout>
