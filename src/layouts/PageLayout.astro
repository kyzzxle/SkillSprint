---
// Simple content page: heading block + body container.
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
  description: string;
  heading: string;
  lead?: string;
  noindex?: boolean;
  narrow?: boolean;
}
const { title, description, heading, lead, noindex, narrow } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><span aria-current="page">{heading}</span></li></ol></nav>
      <h1>{heading}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </div>
  <div class="container section" style="padding-top:1.5rem">
    <div class={narrow ? 'prose' : ''}>
      <slot />
    </div>
  </div>
</BaseLayout>
