---
// Layout for every game page: lane header, playable stage, guide content, FAQ and the next lanes.
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import AdSlot from '../components/AdSlot.astro';
import { CATEGORIES, categoryById, gamesInCategory, GAMES, type CategoryId } from '../data/catalog';

interface Faq { q: string; a: string }
interface Props {
  gamePageId: string;
  title: string;
  description: string;
  heading?: string;
  lead?: string;
  faqs?: Faq[];
}
const { gamePageId, title, description, heading, lead, faqs = [] } = Astro.props;
const game = GAMES.find((g) => g.id === gamePageId)!;
const cat = categoryById(game.category as CategoryId);
const siblings = gamesInCategory(cat.id).filter((g) => g.id !== game.id);
const isCategoryPage = game.url === cat.url;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'All games', url: '/games/' }];
if (!isCategoryPage) crumbs.push({ name: cat.name, url: cat.url });
crumbs.push({ name: isCategoryPage ? cat.name : game.name, url: game.url });
const site = Astro.site!;
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.url, site).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: game.name,
    url: new URL(game.url, site).href,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any (web browser)',
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
  },
];
if (faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const laneNo = CATEGORIES.findIndex((c) => c.id === cat.id) + 1;
// The next three lanes (wrapping round) keep players moving through all ten skills.
const nextLanes = [1, 2, 3].map((k) => {
  const i = (laneNo - 1 + k) % CATEGORIES.length;
  return { ...CATEGORIES[i], lane: i + 1 };
});
const badgeLabel = `Lane ${laneNo}: ${cat.name}`;
const stageLabel = `${game.name} game`;
---
<BaseLayout title={title} description={description} cat={cat.id} jsonLd={jsonLd}>
  <div class="page-head" data-cat={cat.id}>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.url}>{c.name}</a>}</li>)}
        </ol>
      </nav>
      <div class="head-row">
        <a class="lane-badge" href={cat.url} aria-label={badgeLabel}><small>Lane</small><b>{laneNo}</b></a>
        <h1>{heading ?? game.name}</h1>
      </div>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </div>

  <div class="container">
    <section class="game-stage" data-cat={cat.id} aria-label={stageLabel}>
      <slot />
    </section>
    {siblings.length > 0 && (
      <section class="section" style="padding-bottom:0" aria-labelledby="more-games" data-cat={cat.id}>
        <h2 id="more-games">More in lane {laneNo}</h2>
        <div class="game-list">
          {siblings.map((g) => (
            <a class="game-card" href={g.url}>
              <span class="cat-icon"><Icon name={g.category} /></span>
              <span><h3>{g.name}</h3><p>{g.short}</p></span>
            </a>
          ))}
        </div>
      </section>
    )}

    <AdSlot slot="category" size="banner" />

    <article class="prose section" style="padding-top:1rem">
      <slot name="guide" />
      {faqs.length > 0 && (
        <section class="faq">
          <h2>Questions people ask</h2>
          {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </section>
      )}
    </article>
  </div>

  <section class="track" aria-labelledby="next-lanes">
    <div class="container track-head">
      <h2 id="next-lanes">Next lanes</h2>
      <p>Keep your run going, or see <a href="/games/" style="color:#fff">all ten lanes</a>.</p>
    </div>
    <ol class="lanes">
      {nextLanes.map((l) => (
        <li class="lane" data-cat={l.id}>
          <a class="container" href={l.url}>
            <span class="lane-num" aria-hidden="true">{l.lane}</span>
            <span class="lane-body">
              <span class="lane-name">{l.name}</span>
              <span class="lane-desc">{l.tagline}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
