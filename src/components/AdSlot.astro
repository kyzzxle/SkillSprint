---
// Advertisement slot. Renders a clearly-labelled placeholder until AdSense is configured in src/config/site.ts.
// Never place this inside game controls or answer areas.
import { ADS } from '../config/site';
interface Props { slot: string; size?: 'banner' | 'rect' | 'inline' }
const { slot, size = 'banner' } = Astro.props;
const slotId = ADS.slots[slot];
const live = ADS.enabled && ADS.client && slotId;
---
{live ? (
  <aside class="ad-slot" data-size={size} aria-label="Advertisement">
    <ins class="adsbygoogle" style="display:block;width:100%" data-ad-client={ADS.client} data-ad-slot={slotId} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
) : ADS.showPlaceholders ? (
  <aside class="ad-slot" data-size={size} data-ad-placeholder={slot} aria-label="Advertisement placeholder">
    <span class="ad-label">Advertisement space</span>
  </aside>
) : null}
